<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:c="http://www.springframework.org/schema/c"
	xmlns:p="http://www.springframework.org/schema/p"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Repository -->
	<bean id="commonCodeDAO" class="com.spring.dao.CommonCodeDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="memberDAO" class="com.spring.dao.MemberDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="animalDetailDAO" class="com.spring.dao.AnimalDetailDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="animalCounterDAO" class="com.spring.dao.AnimalCounterDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="dangerDetailDAO" class="com.spring.dao.DangerDetailDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="droneDAO" class="com.spring.dao.DroneDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="detectionLogDAO" class="com.spring.dao.DetectionLogDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="dangerLogDAO" class="com.spring.dao.DangerLogDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="flightHistoryDAO" class="com.spring.dao.FlightHistoryDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="AlertLogDAO" class="com.spring.dao.AlertLogDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="LoginLogDAO" class="com.spring.dao.LoginLogDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="PatrolReportDAO" class="com.spring.dao.PatrolReportDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>
	<bean id="VideoDroneMapDAO" class="com.spring.dao.VideoDroneMapDAOImpl">
		<constructor-arg ref="sqlSession" />
	</bean>

	<!-- 2. Service 빈 설정: ref에 적힌 이름과 위 id가 완벽하게 일치해야 합니다 -->
	<bean id="commonCodeService"
		class="com.spring.service.CommonCodeServiceImpl">
		<constructor-arg ref="commonCodeDAO" />
	</bean>
	<bean id="memberService" class="com.spring.service.MemberServiceImpl">
		<constructor-arg ref="memberDAO" />
	</bean>
	<bean id="animalDetailService"
		class="com.spring.service.AnimalDetailServiceImpl">
		<constructor-arg ref="animalDetailDAO" />
		<!-- 💡 실시간 카운터 연동을 위한 레포지토리 참조 주입 추가 -->
		<constructor-arg ref="animalCounterDAO" />
	</bean>
	<bean id="animalCounterService"
		class="com.spring.service.AnimalCounterServiceImpl">
		<constructor-arg ref="animalCounterDAO" />
	</bean>
	<bean id="dangerDetailService"
		class="com.spring.service.DangerDetailServiceImpl">
		<constructor-arg ref="dangerDetailDAO" />
	</bean>
	<bean id="droneService" class="com.spring.service.DroneServiceImpl">
		<constructor-arg ref="droneDAO" />
	</bean>
	<bean id="detectionLogService"
		class="com.spring.service.DetectionLogServiceImpl">
		<constructor-arg ref="detectionLogDAO" />
	</bean>
	<bean id="dangerLogService" class="com.spring.service.DangerLogServiceImpl">
		<constructor-arg ref="dangerLogDAO" />
	</bean>
	<bean id="flightHistoryService"
		class="com.spring.service.FlightHistoryServiceImpl">
		<constructor-arg ref="flightHistoryDAO" />
	</bean>
	<bean id="AlertLogService"
		class="com.spring.service.AlertLogServiceImpl">
		<constructor-arg ref="AlertLogDAO" />
	</bean>
	<bean id="PatrolReportService"
		class="com.spring.service.PatrolReportServiceImpl">
		<constructor-arg ref="PatrolReportDAO" />
	</bean>
	<!-- 2. 실시간 AI 스트림 캐시 관리 엔진 등록 -->
	<!-- 💡 중요: 실제 파일 최상단에 package com.spring.yolo; 라고 선언되어 있으므로 class 경로를 com.spring.yolo로 정밀 조준합니다. -->
	<bean id="AIStreamBridgeService" class="com.spring.yolo.AIStreamBridgeService">
	    <!-- 자바 파일에 구현된 public AIStreamBridgeService(VideoDroneMapDAO videoDroneMapDAO) 구조 만족을 위해 주입 -->
	    <constructor-arg ref="VideoDroneMapDAO" />
	</bean>
	<!-- 3. 비즈니스 맵 매핑 서비스 조립 (자바 코드의 @AllArgsConstructor 인자 개수 2개 완벽 결합) -->
	<bean id="VideoDroneMapService" class="com.spring.service.VideoDroneMapServiceImpl">
	    <!-- 1번째 인자: 위에서 개설한 대문자 ID의 DAO를 대소문자 정확히 매칭하여 주입 -->
	    <constructor-arg ref="VideoDroneMapDAO" />
	    
	    <!-- 2번째 인자: [누락 해결] 자바 파일이 애타게 기다리던 AIStreamBridgeService 빈을 안전하게 토스 -->
	    <constructor-arg ref="AIStreamBridgeService" />
	</bean>



</beans>