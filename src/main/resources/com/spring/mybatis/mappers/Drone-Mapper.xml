<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="Drone-Mapper">

    <!-- DB 영문 컬럼명과 롬복 VO 1:1 매핑 -->
    <resultMap id="droneMap" type="com.spring.dto.DroneVO">
        <id property="droneId" column="DRONE_ID" />
        <result property="memberId" column="MEMBER_ID" />
    </resultMap>

    <!-- PageMaker 연동 동적 검색 조건 (d: 드론ID, m: 담당 관제원 사번) -->
    <sql id="searchCondition">
        <where>
            <if test="searchType == 'd'.toString() and keyword != null and keyword != ''">
                AND DRONE_ID LIKE '%' || #{keyword} || '%'
            </if>
            <if test="searchType == 'm'.toString() and keyword != null and keyword != ''">
                AND MEMBER_ID LIKE '%' || #{keyword} || '%'
            </if>
        </where>
    </sql>

    <!-- [CREATE] 1. 신규 드론 등록 (DRONE 테이블 매핑) -->
    <insert id="insertDrone" parameterType="com.spring.dto.DroneVO">
        INSERT INTO DRONE (
            DRONE_ID, MEMBER_ID
        ) VALUES (
            #{droneId},
            #{memberId, jdbcType=VARCHAR}
        )
    </insert>

    <!-- [READ] 2. 페이징 처리된 드론 목록 조회 -->
    <select id="selectDroneList" resultMap="droneMap" parameterType="com.spring.cmd.PageMaker">
        SELECT * FROM (
            SELECT ROWNUM AS rn, a.* FROM (
                SELECT 
                    DRONE_ID, MEMBER_ID
                FROM DRONE
                <include refid="searchCondition" />
                ORDER BY DRONE_ID ASC
            ) a WHERE ROWNUM &lt;= #{endRow}
        ) WHERE rn &gt;= #{startRow}
    </select>

    <!-- [READ] 3. 페이징 계산용 전체 드론 대수 카운트 (DRONE 테이블 매핑) -->
    <select id="selectDroneCount" resultType="int" parameterType="com.spring.cmd.PageMaker">
        SELECT COUNT(*) 
        FROM DRONE
        <include refid="searchCondition" />
    </select>

    <!-- [READ] 4. 드론 상세 단건 조회 -->
    <select id="selectDroneById" resultMap="droneMap" parameterType="string">
        SELECT 
            DRONE_ID, MEMBER_ID
        FROM DRONE
        WHERE DRONE_ID = #{droneId}
    </select>

    <!-- [UPDATE] 5. 드론 담당 관제원 변경 -->
    <update id="updateDrone" parameterType="com.spring.dto.DroneVO">
        UPDATE DRONE
        SET 
            MEMBER_ID = #{memberId, jdbcType=VARCHAR}
        WHERE DRONE_ID = #{droneId}
    </update>

    <!-- [DELETE] 6. 드론 정보 삭제 -->
    <delete id="deleteDrone" parameterType="string">
        DELETE FROM DRONE
        WHERE DRONE_ID = #{droneId}
    </delete>

</mapper>
